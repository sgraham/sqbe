From d8d519cf63706735b6bdae556411507cb4e44b93 Mon Sep 17 00:00:00 2001
From: Scott Graham <scott.github@h4ck3r.net>
Date: Mon, 10 Feb 2025 14:47:45 -0800
Subject: [PATCH 07/14] Use qbe_free() instead of free() directly

Pair emalloc() with qbe_free() rather than free() directly. This is so
that when emalloc() is overridden in a library context, free() can also
be revectored.
---
 all.h        |  1 +
 amd64/isel.c |  2 +-
 cfg.c        |  6 +++---
 emit.c       |  2 +-
 gvn.c        |  4 ++--
 mem.c        |  2 +-
 parse.c      |  2 +-
 spill.c      |  2 +-
 ssa.c        |  4 ++--
 util.c       | 12 +++++++++---
 10 files changed, 22 insertions(+), 15 deletions(-)

diff --git a/all.h b/all.h
index 6d6b485..215a375 100644
--- a/all.h
+++ b/all.h
@@ -631,6 +631,7 @@ uint32_t hash(char *);
 void die_(char *, char *, ...) __attribute__((noreturn));
 void *emalloc(size_t);
 void *alloc(size_t);
+void qbe_free(void *);
 void freeall(void);
 void *vnew(ulong, size_t, Pool);
 void vfree(void *);
diff --git a/amd64/isel.c b/amd64/isel.c
index 126d918..ff7db2c 100644
--- a/amd64/isel.c
+++ b/amd64/isel.c
@@ -933,7 +933,7 @@ amd64_isel(Fn *fn)
 		}
 		idup(b, GC(curi), &GC(insb)[NIns]-GC(curi));
 	}
-	free(num);
+	qbe_free(num);
 
 	if (GC(debug)['I']) {
 		fprintf(stderr, "\n> After instruction selection:\n");
diff --git a/cfg.c b/cfg.c
index 5d54308..1bd93ef 100644
--- a/cfg.c
+++ b/cfg.c
@@ -359,7 +359,7 @@ simpljmp(Fn *fn)
 		}
 	}
 	*p = ret;
-	free(uf);
+	qbe_free(uf);
 }
 
 static int
@@ -558,8 +558,8 @@ simplcfg(Fn *fn)
 		}
 
 	fillcfg(fn);
-	free(empty);
-	free(jmp);
+	qbe_free(empty);
+	qbe_free(jmp);
 
 	if (GC(debug)['C']) {
 		fprintf(stderr, "\n> After CFG simplification:\n");
diff --git a/emit.c b/emit.c
index 0d0d7ff..d02d4b4 100644
--- a/emit.c
+++ b/emit.c
@@ -192,7 +192,7 @@ emitfin(FILE *f, char *sec[3])
 		}
 	while ((b=G(stash))) {
 		G(stash) = b->link;
-		free(b);
+		qbe_free(b);
 	}
 }
 
diff --git a/gvn.c b/gvn.c
index 18cd630..be2994a 100644
--- a/gvn.c
+++ b/gvn.c
@@ -452,7 +452,7 @@ rebuildcfg(Fn *fn)
 			if (gvndup(i, 0) == i)
 				addins(&s->ins, &s->nins, i);
 	}
-	free(rpo);
+	qbe_free(rpo);
 }
 
 /* requires rpo pred ssa use
@@ -496,7 +496,7 @@ gvn(Fn *fn)
 		dedupjmp(fn, b);
 	}
 	rebuildcfg(fn);
-	free(gvntbl);
+	qbe_free(gvntbl);
 	gvntbl = 0;
 
 	if (GC(debug)['G']) {
diff --git a/mem.c b/mem.c
index 4afad11..2b0640e 100644
--- a/mem.c
+++ b/mem.c
@@ -302,7 +302,7 @@ coalesce(Fn *fn)
 			}
 		br[n].a = ip;
 	}
-	free(br);
+	qbe_free(br);
 
 	/* kill dead stores */
 	for (s=sl; s<&sl[nsl]; s++)
diff --git a/parse.c b/parse.c
index e93763d..b0b1529 100644
--- a/parse.c
+++ b/parse.c
@@ -371,7 +371,7 @@ tmpref(char *v)
 	int t, i;
 
 	if (G(tmphcap)/2 <= G(curf)->ntmp-Tmp0) {
-		free(G(tmph));
+		qbe_free(G(tmph));
 		G(tmphcap) = G(tmphcap) ? G(tmphcap)*2 : TMask+1;
 		G(tmph) = emalloc(G(tmphcap) * sizeof G(tmph)[0]);
 		for (t=Tmp0; t<G(curf)->ntmp; t++) {
diff --git a/spill.c b/spill.c
index 9b0c24e..07d1fa4 100644
--- a/spill.c
+++ b/spill.c
@@ -164,7 +164,7 @@ limit(BSet *b, int k, BSet *f)
 	if (nt <= k)
 		return;
 	if (nt > G(limit_maxt)) {
-		free(G(limit_tarr));
+		qbe_free(G(limit_tarr));
 		G(limit_tarr) = emalloc(nt * sizeof G(limit_tarr)[0]);
 		G(limit_maxt) = nt;
 	}
diff --git a/ssa.c b/ssa.c
index 90f9807..0c38681 100644
--- a/ssa.c
+++ b/ssa.c
@@ -200,7 +200,7 @@ phiins(Fn *fn)
 			}
 		}
 	}
-	free(blist);
+	qbe_free(blist);
 }
 
 struct Name {
@@ -344,7 +344,7 @@ ssa(Fn *fn)
 			nfree(n);
 		}
 	GC(debug)['L'] = d;
-	free(stk);
+	qbe_free(stk);
 	if (GC(debug)['N']) {
 		fprintf(stderr, "\n> After SSA construction:\n");
 		printfn(fn, stderr);
diff --git a/util.c b/util.c
index bc2cf21..e1e2dcb 100644
--- a/util.c
+++ b/util.c
@@ -57,6 +57,12 @@ emalloc(size_t n)
 	return p;
 }
 
+// to allow revectoring in sqbe
+void
+qbe_free(void *ptr) {
+	free(ptr);
+}
+
 void *
 alloc(size_t n)
 {
@@ -80,11 +86,11 @@ freeall(void)
 
 	for (;;) {
 		for (pp = &G(pool)[1]; pp < &G(pool)[G(nptr)]; pp++)
-			free(*pp);
+			qbe_free(*pp);
 		pp = G(pool)[0];
 		if (!pp)
 			break;
-		free(G(pool));
+		qbe_free(G(pool));
 		G(pool) = pp;
 		G(nptr) = util__NPtr;
 	}
@@ -118,7 +124,7 @@ vfree(void *p)
 	assert(v->mag == VMag);
 	if (v->pool == PHeap) {
 		v->mag = 0;
-		free(v);
+		qbe_free(v);
 	}
 }
 
-- 
