From 99a6bfab592fe64d2395b1dcf43d98650c1c810a Mon Sep 17 00:00:00 2001
From: Scott Graham <scott.github@h4ck3r.net>
Date: Mon, 30 Jun 2025 12:53:27 -0700
Subject: [PATCH 10/17] remove unused functions addbin and cmpwlneg causing
 warnings

also remove sort of (?) unused var in gvndup
---
 all.h  |  1 -
 gvn.c  |  4 ++--
 util.c | 10 ----------
 3 files changed, 2 insertions(+), 13 deletions(-)

diff --git a/all.h b/all.h
index e89c313..950fafd 100644
--- a/all.h
+++ b/all.h
@@ -659,7 +659,6 @@ void idup(Blk *, Ins *, ulong);
 Ins *icpy(Ins *, Ins *, ulong);
 int cmpop(int);
 int cmpneg(int);
-int cmpwlneg(int);
 int clsmerge(short *, short);
 int phicls(int, Tmp *);
 uint phiargn(Phi *, Blk *);
diff --git a/gvn.c b/gvn.c
index be2994a..8cd52b4 100644
--- a/gvn.c
+++ b/gvn.c
@@ -41,11 +41,11 @@ static uint gvntbln;
 static Ins *
 gvndup(Ins *i, int insert)
 {
-	uint idx, n;
+	uint idx;
 	Ins *ii;
 
 	idx = ihash(i) % gvntbln;
-	for (n=1;; n++) {
+	for (;;) {
 		ii = gvntbl[idx];
 		if (!ii)
 			break;
diff --git a/util.c b/util.c
index e1e2dcb..d0495fe 100644
--- a/util.c
+++ b/util.c
@@ -368,16 +368,6 @@ cmpop(int c)
 	return cmptab[c][1];
 }
 
-int
-cmpwlneg(int op)
-{
-	if (INRANGE(op, Ocmpw, Ocmpw1))
-		return cmpneg(op - Ocmpw) + Ocmpw;
-	if (INRANGE(op, Ocmpl, Ocmpl1))
-		return cmpneg(op - Ocmpl) + Ocmpl;
-	die("not a wl comparison");
-}
-
 int
 clsmerge(short *pk, short k)
 {
