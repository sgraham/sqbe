+                rd = i->to.val - V0;
+                enc = 0xBD400000u;
+                scale = 4;
+              } else if (i->cls == Kd) {
+                rd = i->to.val - V0;
+                enc = 0xFD400000u;
+                scale = 8;
+              } else {
+                enc = wide ? 0xF9400000u : 0xB9400000u;
+                scale = wide ? 8 : 4;
+              }
