+            rd = i->to.val - V0;
+            rn = i->arg[0].val - V0;
+            rm = i->arg[1].val - V0;
+            enc = (i->cls == Kd) ? 0x1E601800u : 0x1E201800u;
+            emit_u32(ctx, enc | ((uint32_t)rm << 16) | ((uint32_t)rn << 5) | (uint32_t)rd);
