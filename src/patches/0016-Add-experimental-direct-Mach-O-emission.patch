+            case Ks:  // fmov Sd, Wn: FP=to, GPR=arg[0]
+              rd = i->to.val - V0;
+              rn = i->arg[0].val - R0;
+              emit_u32(ctx, 0x1E270000u | ((uint32_t)rn << 5) | (uint32_t)rd);
