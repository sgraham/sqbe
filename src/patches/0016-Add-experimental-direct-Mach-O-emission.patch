+              break;
+            case Oloadub:
+              enc = 0x39400000u;
+              scale = 1;
+              break;
+            case Oloadsh:
+              enc = wide ? 0x79800000u : 0x79C00000u;
+              scale = 2;
+              break;
+            case Oloaduh:
+              enc = 0x79400000u;
+              scale = 2;
+              break;
