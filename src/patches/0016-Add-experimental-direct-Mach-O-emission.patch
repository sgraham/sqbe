+          rn = i->arg[0].val - R0;
+          rm = i->arg[1].val - R0;
+          wide = (i->cls == Kl);
+          if (i->op == Osar) {
+            enc = wide ? 0x9AC02800u : 0x1AC02800u;
+          } else if (i->op == Oshr) {
