+            rd = i->to.val - V0;
+            rm = i->arg[0].val - V0;
+            enc = (i->cls == Kd) ? 0x1E614000u : 0x1E214000u;
+            emit_u32(ctx, enc | ((uint32_t)rm << 5) | (uint32_t)rd);
+            break;
+          }
+          rd = i->to.val - R0;
+          rm = i->arg[0].val - R0;
+          wide = (i->cls == Kl);
+          enc = wide ? 0xCB0003E0u : 0x4B0003E0u;
+          emit_u32(ctx, enc | ((uint32_t)rm << 16) | (uint32_t)rd);
