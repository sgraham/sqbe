+        case Orem:
+        case Ourem: {
+          int scratch = IP1 - R0;  // x17 - intra-procedure scratch
+          assert(isreg(i->to) && isreg(i->arg[0]) && isreg(i->arg[1]));
+          rd = i->to.val - R0;
+          rn = i->arg[0].val - R0;  // dividend
+          rm = i->arg[1].val - R0;  // divisor
+          wide = (i->cls == Kl);
+          // step 1: scratch = dividend / divisor
+          enc = (i->op == Orem) ? (wide ? 0x9AC00C00u : 0x1AC00C00u)   // SDIV
+                                : (wide ? 0x9AC00800u : 0x1AC00800u);  // UDIV
+          emit_u32(ctx, enc | ((uint32_t)rm << 16) | ((uint32_t)rn << 5) | (uint32_t)scratch);
