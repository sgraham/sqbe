diff --git a/test/objptr.ssa b/test/objptr.ssa
new file mode 100644
index 0000000..2cc4909
--- /dev/null
+++ b/test/objptr.ssa
@@ -0,0 +1,19 @@
+# Regression: pointer data after a text section whose byte-length is not a
+# multiple of 8 must still be 8-byte aligned in the Mach-O -f macho output.
+# (Previously, sec.addr = textsz without rounding caused ld to reject with
+#  "pointer not aligned".)
+data $msg = { b "hi", b 0 }
+data $ref = { l $msg }
+
+export function w $main() {
+@start
+	%p =l loadl $ref
+	call $puts(l %p)
+	call $puts(l %p)
+	ret 0
+}
+
+# >>> output
+# hi
+# hi
+# <<<
diff --git a/tools/objtest.sh b/tools/objtest.sh
new file mode 100755
index 0000000..9c6b3a1
--- /dev/null
+++ b/tools/objtest.sh
@@ -0,0 +1,95 @@
+#!/bin/sh
+# Compare text-assembly output vs -f macho Mach-O for arm64_apple.
+# Usage: tools/objtest.sh [file.ssa ...]
+# Requires: clang (arm64 capable), otool
+#
+QBE=${QBE:-./qbe}
+PASS=0; FAIL=0; SKIP=0
+
+# Disassemble a Mach-O, strip file/section headers and address prefixes.
+normalize() {
+	otool -tv "$1" | awk '
+		/^\// { next }
+		/^\(/ { next }
+		/^[0-9a-f]/ { print substr($0, index($0, "\t") + 1); next }
+		{ print }
+	'
+}
+
+extract_output() {
+	awk '/^# >>> output/{p=1;next}/^# <</{p=0}p{sub(/^# ?/,"");print}' "$1"
+}
+
+run() {
+	ssa="$1"
+	name=$(basename "$ssa" .ssa)
+	tmp="/tmp/qbe_objtest_$$_${name}"
+
+	# --- text path ---
+	if ! "$QBE" -t arm64_apple -o "${tmp}.s" "$ssa" 2>/dev/null; then
+		echo "SKIP $name (qbe -t arm64_apple failed)"
+		SKIP=$((SKIP+1)); return
+	fi
+	if ! clang -arch arm64 -c "${tmp}.s" -o "${tmp}_text.o" 2>/dev/null; then
+		echo "SKIP $name (clang assembly failed)"
+		rm -f "${tmp}.s"
+		SKIP=$((SKIP+1)); return
+	fi
+
+	# --- obj path ---
+	if ! "$QBE" -f macho -t arm64_apple -o "${tmp}_obj.o" "$ssa" 2>/dev/null; then
+		echo "SKIP $name (-f macho failed/unsupported)"
+		rm -f "${tmp}.s" "${tmp}_text.o"
+		SKIP=$((SKIP+1)); return
+	fi
+
+	# --- link check: catch "pointer not aligned" and similar ld errors ---
+	lnk_err=$(clang -arch arm64 "${tmp}_obj.o" -o "${tmp}_obj_exe" 2>&1); lnk_ec=$?
+	if echo "$lnk_err" | grep -q "not aligned"; then
+		echo "FAIL $name (link: pointer not aligned)"
+		rm -f "${tmp}.s" "${tmp}_text.o" "${tmp}_obj.o" "${tmp}_obj_exe"
+		FAIL=$((FAIL+1)); return
+	fi
+
+	# --- run check (when expected output is present and link succeeded) ---
+	expected=$(extract_output "$ssa")
+	if [ -n "$expected" ] && [ $lnk_ec -eq 0 ]; then
+		actual=$("${tmp}_obj_exe" a b c 2>/dev/null)
+		if [ "$actual" != "$expected" ]; then
+			echo "FAIL $name (output mismatch)"
+			printf "  expected: %s\n  got:      %s\n" "$expected" "$actual"
+			rm -f "${tmp}.s" "${tmp}_text.o" "${tmp}_obj.o" "${tmp}_obj_exe"
+			FAIL=$((FAIL+1)); return
+		fi
+	fi
+	rm -f "${tmp}_obj_exe"
+
+	# --- compare disassembly ---
+	normalize "${tmp}_text.o" > "${tmp}_text.norm"
+	normalize "${tmp}_obj.o"  > "${tmp}_obj.norm"
+
+	if diff "${tmp}_text.norm" "${tmp}_obj.norm" >/dev/null 2>&1; then
+		echo "PASS $name"
+		PASS=$((PASS+1))
+	else
+		echo "FAIL $name"
+		diff "${tmp}_text.norm" "${tmp}_obj.norm"
+		FAIL=$((FAIL+1))
+	fi
+
+	rm -f "${tmp}.s" "${tmp}_text.o" "${tmp}_obj.o" \
+	      "${tmp}_text.norm" "${tmp}_obj.norm"
+}
+
+if [ $# -eq 0 ]; then
+	for f in test/*.ssa; do
+		case $(basename "$f") in _*) continue ;; esac
+		run "$f"
+	done
+else
+	for f in "$@"; do run "$f"; done
+fi
+
+echo ""
+echo "passed=$PASS failed=$FAIL skipped=$SKIP"
+[ "$FAIL" -eq 0 ]
