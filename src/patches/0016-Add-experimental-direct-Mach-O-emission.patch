+        }
+        case Oand:
+        case Oor:
+        case Oxor:
+          assert(isreg(i->to) && isreg(i->arg[0]) && isreg(i->arg[1]));
+          rd = i->to.val - R0;
+          rn = i->arg[0].val - R0;
+          rm = i->arg[1].val - R0;
+          wide = (i->cls == Kl);
+          if (i->op == Oand) {
+            enc = wide ? 0x8A000000u : 0x0A000000u;
+          } else if (i->op == Oor) {
