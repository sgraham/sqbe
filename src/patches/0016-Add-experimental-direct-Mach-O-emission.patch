+          }
+          if (isreg(addr)) {
+            rn = addr.val - R0;
+            emit_u32(ctx, enc | ((uint32_t)rn << 5) | (uint32_t)rd);
+          } else {
+            uint32_t off;
+            assert(rtype(addr) == RSlot);
+            off = slot_off(rsval(addr), padding, framesz);
+            emit_u32(ctx, enc | ((off / (uint32_t)scale) << 10) | (29u << 5) | (uint32_t)rd);
+          }
+          break;
+        }
+        case Oextsb:
+        case Oextub:
+        case Oextsh:
+        case Oextuh:
+        case Oextsw:
+        case Oextuw:
+          assert(isreg(i->to) && isreg(i->arg[0]));
+          rd = i->to.val - R0;
+          rn = i->arg[0].val - R0;
+          wide = (i->cls == Kl);
+          switch (i->op) {
+            case Oextsb:
