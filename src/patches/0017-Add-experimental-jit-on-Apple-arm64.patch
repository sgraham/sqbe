+	cc -arch arm64 -o "${tmp}_tramp.o" -c "${tmp}_tramp.s" 2>/dev/null || true
+	cc -arch arm64 -o "${tmp}_init.o" -c "${tmp}_init.c" 2>/dev/null || true
+
+	# Link driver binary
