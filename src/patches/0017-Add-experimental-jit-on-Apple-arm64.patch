+extract_driver() {
+	awk '/^# >>> driver/{p=1;next}/^# <</{p=0}p{sub(/^# ?/,"");print}' "$1"
+}
+
+run_jit_driver() {
+	ssa="$1"; name="$2"; tmp="$3"; expected="$4"
+	libqbe="${LIBQBE:-./libqbe.a}"
+	[ -f "$libqbe" ] || { echo "SKIP $name (jit-driver: libqbe.a not found)"; SKIP=$((SKIP+1)); return; }
+
+	# Extract driver C source, rename main -> driver_main
+	extract_driver "$ssa" | sed 's/int main(/int driver_main(/;s/void main(/void driver_main(/' \
+		> "${tmp}_drv.c"
+
+	# Extract all exported function names from .ssa (e.g. $f -> f); skip "main"
+	awk '
+		/^export *$/ { export=1; next }
+		/^export  *function / && /\$/ { fn=$0; sub(/^.*\$/, "", fn); sub(/[( ].*/, "", fn); if (fn!="main") print fn; next }
+		export && /^function / && /\$/ { fn=$0; sub(/^.*\$/, "", fn); sub(/[( ].*/, "", fn); if (fn!="main") print fn; export=0; next }
+		{ export=0 }
+	' "$ssa" > "${tmp}_fns.txt"
+
+	# Generate arm64 trampolines
+	{
+	  while IFS= read -r fn; do
+		printf '.section __TEXT,__text,regular,pure_instructions\n'
+		printf '.global _%s\n.align 2\n_%s:\n' "$fn" "$fn"
+		printf '    adrp x16, _jit_%s_ptr@PAGE\n' "$fn"
+		printf '    ldr  x16, [x16, _jit_%s_ptr@PAGEOFF]\n' "$fn"
+		printf '    br   x16\n'
+		printf '.section __DATA,__data\n.global _jit_%s_ptr\n.align 3\n_jit_%s_ptr:\n    .quad 0\n\n' "$fn" "$fn"
+	  done < "${tmp}_fns.txt"
+	} > "${tmp}_tramp.s"
+
+	# Generate a constructor that pre-fills each _jit_f_ptr with the system symbol
+	# (if one exists), so calls during C runtime startup don't crash on null pointers.
+	# jit_populate_ptrs() will overwrite with the JIT address after finalization.
+	{
+	  printf '#include <dlfcn.h>\n'
+	  while IFS= read -r fn; do
+		printf 'extern void *jit_%s_ptr;\n' "$fn"
+	  done < "${tmp}_fns.txt"
+	  printf '__attribute__((constructor)) static void _jit_init_ptrs(void) {\n'
+	  printf '    void *sym;\n'
+	  while IFS= read -r fn; do
+		printf '    sym = dlsym(RTLD_NEXT, "%s");\n' "$fn"
+		printf '    if (sym) jit_%s_ptr = sym;\n' "$fn"
