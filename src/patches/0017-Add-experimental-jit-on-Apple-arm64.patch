+		echo "SKIP $name (jit-driver: binary exited non-zero / unsupported feature)"
+		SKIP=$((SKIP+1)); return
+	fi
+	if [ -n "$expected" ] && [ "$actual" != "$expected" ]; then
+		echo "FAIL $name (jit-driver output mismatch)"
+		printf "  expected: %s\n  got:      %s\n" "$expected" "$actual"
+		FAIL=$((FAIL+1)); return
+	fi
+	echo "PASS $name (jit-driver)"
+	PASS=$((PASS+1))
+}
