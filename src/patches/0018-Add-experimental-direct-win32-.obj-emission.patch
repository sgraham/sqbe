diff --git a/tools/pecobjtest.sh b/tools/pecobjtest.sh
new file mode 100644
index 0000000..263a400
--- /dev/null
+++ b/tools/pecobjtest.sh
@@ -0,0 +1,183 @@
+#!/bin/sh
+# Test -f pecoff (PE/COFF direct emission) vs text-assembly path for amd64_win.
+# Usage: tools/pecobjtest.sh [file.ssa ...]
+# Requires: x86_64-w64-mingw32-gcc, wine (and optionally dumpbin)
+#
+QBE=${QBE:-./qbe}
+CC=${CC:-x86_64-w64-mingw32-gcc}
+OBJDUMP=${OBJDUMP:-x86_64-w64-mingw32-objdump}
+PASS=0; FAIL=0; SKIP=0
+export WINEDEBUG=-all
+
+# Disassemble a COFF .obj, strip addresses, show instructions only.
+#
+# Pass 1: extract instruction text from "objdump -d -r" output; also resolve
+#   call targets so both paths compare identically:
+#   - GAS computes the direct PC-relative offset for same-file calls (no reloc),
+#     so objdump shows e.g. "call 0 <alpha>" with the correct symbol in < >.
+#   - Our emitter always emits relocs, so objdump shows "call 54 <test+0x24>"
+#     with a following "IMAGE_REL_AMD64_REL32 alpha" relocation line.
+#   Strategy: buffer each "call" instruction.  If the next line is a relocation,
+#   emit "call <symbol>" from the reloc.  Otherwise (GAS direct call), extract
+#   the symbol name from the "<sym>" annotation in the instruction text itself.
+#   Both paths end up emitting "call <symbol>".
+#
+# Pass 2: collapse all NOP variants (multi-byte fancy NOPs, xchg %ax,%ax)
+#         into a single "nop" line.
+#
+# Pass 3: normalize RIP-relative memory operands.  GAS bakes the within-section
+#   byte offset into the displacement field (e.g. "0x8(%rip)"); our emitter
+#   emits 0x0 and relies on the linker relocation.  Both are equivalent after
+#   linking.  Strip the displacement and the trailing objdump annotation.
+normalize() {
+	"$OBJDUMP" -d -r --no-show-raw-insn "$1" | \
+		awk '
+		function flush_call(    sym) {
+			# No reloc followed the buffered call.  Extract the symbol
+			# from the "<sym>" annotation (stops at "+" so "<sym+off>"
+			# does not match — left as-is as a safe fallback).
+			sym = pcall
+			if (match(sym, /<[^+>]+>/))
+				print "call\t" substr(sym, RSTART+1, RLENGTH-2)
+			else
+				print pcall
+			pcall = ""
+		}
+		/^[0-9a-f]+ </         { if (pcall != "") flush_call(); p=1; next }
+		/IMAGE_REL_AMD64_REL32/ {
+			# Must be tested BEFORE the instruction pattern because reloc
+			# lines share the same "addr: ..." prefix format.
+			# Always suppress reloc lines; apply to pending call if present.
+			if (p && pcall != "") {
+				sym = $NF; sub(/[+-].*$/, "", sym)
+				print "call\t" sym
+				pcall = ""
+			}
+			next
+		}
+		p && /^[[:space:]]+[0-9a-f]+:/ {
+			if (pcall != "") flush_call()
+			line = substr($0, index($0, "\t") + 1)
+			if (line ~ /^call[[:space:]]/) { pcall = line }
+			else                           { print line   }
+			next
+		}
+		{ if (pcall != "") flush_call() }
+		END { if (pcall != "") flush_call() }
+		' | \
+		awk '/nop([lw]?[[:space:]]|$)/ || /^xchg[[:space:]]+%ax,%ax/ \
+		     { if (!nop) { print "nop"; nop=1 }; next } \
+		     { nop=0; print }' | \
+		awk '/\(%rip\)/ { sub(/-?0x[0-9a-f]+\(%rip\)/, "(%rip)"); \
+		                  sub(/[[:space:]]*#.*$/, "") } \
+		     { print }'
+}
+
+extract_output() {
+	awk '/^# >>> output/{p=1;next}/^# <</{p=0}p{sub(/^# ?/,"");sub(/#$/,"");print}' "$1"
+}
+
+extract_driver() {
+	awk '/^# >>> driver/{p=1;next}/^# <</{p=0}p{sub(/^# ?/,"");print}' "$1"
+}
+
+run() {
+	ssa="$1"
+	name=$(basename "$ssa" .ssa)
+	tmp="/tmp/qbe_pecobjtest_$$_${name}"
+
+	# --- honour in-file skip directives ---
+	if grep -q '^# skip amd64_win' "$ssa" 2>/dev/null; then
+		echo "SKIP $name (# skip amd64_win)"
+		SKIP=$((SKIP+1)); return
+	fi
+
+	# --- text path ---
+	if ! "$QBE" -t amd64_win -o "${tmp}.s" "$ssa" 2>/dev/null; then
+		echo "SKIP $name (qbe -t amd64_win failed)"
+		SKIP=$((SKIP+1)); return
+	fi
+	if ! "$CC" -c "${tmp}.s" -o "${tmp}_text.obj" 2>/dev/null; then
+		echo "SKIP $name (cc assembly failed)"
+		rm -f "${tmp}.s"
+		SKIP=$((SKIP+1)); return
+	fi
+
+	# --- pecoff path ---
+	# SKIP (not FAIL) if emitter not yet available or fails
+	if ! "$QBE" -f pecoff -t amd64_win -o "${tmp}_obj.obj" "$ssa" 2>/dev/null; then
+		echo "SKIP $name (-f pecoff failed/unsupported)"
+		rm -f "${tmp}.s" "${tmp}_text.obj"
+		SKIP=$((SKIP+1)); return
+	fi
+
+	# --- structural check ---
+	if ! "$OBJDUMP" -f "${tmp}_obj.obj" >/dev/null 2>&1; then
+		echo "FAIL $name (malformed COFF: objdump -f failed)"
+		rm -f "${tmp}.s" "${tmp}_text.obj" "${tmp}_obj.obj"
+		FAIL=$((FAIL+1)); return
+	fi
+
+	# --- compile driver (if present) and link ---
+	drv=$(extract_driver "$ssa")
+	if [ -n "$drv" ]; then
+		printf '%s\n' "$drv" > "${tmp}_drv.c"
+		if ! "$CC" -c "${tmp}_drv.c" -o "${tmp}_drv.obj" 2>/dev/null; then
+			echo "SKIP $name (driver compile failed)"
+			rm -f "${tmp}.s" "${tmp}_text.obj" "${tmp}_obj.obj" "${tmp}_drv.c"
+			SKIP=$((SKIP+1)); return
+		fi
+		lnk_err=$("$CC" -static "${tmp}_obj.obj" "${tmp}_drv.obj" \
+		           -o "${tmp}_obj.exe" 2>&1); lnk_ec=$?
+		rm -f "${tmp}_drv.c" "${tmp}_drv.obj"
+	else
+		lnk_err=$("$CC" -static "${tmp}_obj.obj" -o "${tmp}_obj.exe" 2>&1)
+		lnk_ec=$?
+	fi
+	if [ $lnk_ec -ne 0 ]; then
+		echo "FAIL $name (link failed)"
+		printf "%s\n" "$lnk_err" | sed 's/^/  /'
+		rm -f "${tmp}.s" "${tmp}_text.obj" "${tmp}_obj.obj" "${tmp}_obj.exe"
+		FAIL=$((FAIL+1)); return
+	fi
+
+	# --- run check ---
+	expected=$(extract_output "$ssa")
+	if [ -n "$expected" ]; then
+		actual=$(wine "${tmp}_obj.exe" a b c 2>/dev/null | tr -d '\r')
+		if [ "$actual" != "$expected" ]; then
+			echo "FAIL $name (output mismatch)"
+			printf "  expected: %s\n  got:      %s\n" "$expected" "$actual"
+			rm -f "${tmp}.s" "${tmp}_text.obj" "${tmp}_obj.obj" "${tmp}_obj.exe"
+			FAIL=$((FAIL+1)); return
+		fi
+	fi
+	rm -f "${tmp}_obj.exe"
+
+	# --- disassembly diff (informational only) ---
+	normalize "${tmp}_text.obj" > "${tmp}_text.norm" 2>/dev/null
+	normalize "${tmp}_obj.obj"  > "${tmp}_obj.norm"  2>/dev/null
+	if ! diff "${tmp}_text.norm" "${tmp}_obj.norm" >/dev/null 2>&1; then
+		echo "NOTE $name (disassembly differs from GAS — not a failure)"
+		diff "${tmp}_text.norm" "${tmp}_obj.norm" | head -20
+	fi
+
+	echo "PASS $name"
+	PASS=$((PASS+1))
+
+	rm -f "${tmp}.s" "${tmp}_text.obj" "${tmp}_obj.obj" \
+	      "${tmp}_text.norm" "${tmp}_obj.norm"
+}
+
+if [ $# -eq 0 ]; then
+	for f in test/*.ssa; do
+		case $(basename "$f") in _*) continue ;; esac
+		run "$f"
+	done
+else
+	for f in "$@"; do run "$f"; done
+fi
+
+echo ""
+echo "passed=$PASS failed=$FAIL skipped=$SKIP"
+[ "$FAIL" -eq 0 ]
-- 
